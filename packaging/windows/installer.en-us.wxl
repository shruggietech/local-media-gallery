<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization">
 <String Id="UserExitDescription1">[ProductName] setup was interrupted. Shared Microsoft WebView2 may remain installed if its setup completed. Your galleries and settings are retained.</String>
 <String Id="FatalErrorDescription1">[ProductName] setup could not finish. Shared Microsoft WebView2 may remain installed. Your galleries and settings are retained. Review the displayed error before retrying.</String>
</WixLocalization>
