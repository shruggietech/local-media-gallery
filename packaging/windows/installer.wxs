<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
 <Product Id="@PRODUCT@" Name="Local Media Gallery" Language="1033" Version="@VERSION@" Manufacturer="ShruggieTech" UpgradeCode="@UPGRADE@">
  <Package Id="@PACKAGE@" InstallerVersion="500" Compressed="yes" InstallPrivileges="limited" Platform="x64" Description="Local Media Gallery offline Full installer" />
  <MediaTemplate EmbedCab="yes" />
  <Property Id="ALLUSERS" Value="2" Secure="yes" />
  <Property Id="MSIINSTALLPERUSER" Value="1" Secure="yes" />
  <Property Id="LMG_SCOPE" Value="user" Secure="yes" />
  <Property Id="LMG_STARTMENU" Secure="yes" />
  <Property Id="LMG_PATH" Secure="yes" />
  <Property Id="LMG_EXISTING" Secure="yes" />
  <Property Id="LMG_CONFIGURED" Secure="yes" />
  <Property Id="LMG_LAST_SCOPE" Secure="yes" />
  <Property Id="LMG_RECOVERY" Secure="yes" />
  <Property Id="LMG_RECOVERY_PROTOCOL" Value="1" />
  <Property Id="REBOOT" Value="ReallySuppress" />
  <Property Id="INSTALLDIR" Secure="yes" />
  <Property Id="ARPPRODUCTICON" Value="ApplicationIcon" />
  <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
  <Icon Id="ApplicationIcon" SourceFile="@ICON@" />
  <WixVariable Id="WixUILicenseRtf" Value="@LICENSE@" />
  <Directory Id="TARGETDIR" Name="SourceDir">
   <Directory Id="ProgramFiles64Folder" />
   <Directory Id="LocalAppDataFolder" />
   <Directory Id="INSTALLDIR" Name="Local Media Gallery" />
   <Directory Id="ProgramMenuFolder" />
  </Directory>
  <DirectoryRef Id="INSTALLDIR">
   @FILES@
   <Component Id="Integration" Guid="@INTEGRATION_GUID@" Win64="yes">
    <RegistryKey Root="HKMU" Key="Software\ShruggieTech\LocalMediaGallery">
     <RegistryValue Name="ProductCode" Type="string" Value="[ProductCode]" KeyPath="yes" />
     <RegistryValue Name="PackageCode" Type="string" Value="@PACKAGE@" />
     <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLDIR]" />
     <RegistryValue Name="PayloadSha256" Type="string" Value="@PAYLOAD_SHA@" />
    </RegistryKey>
    @REMOVE_FOLDERS@
   </Component>
   <Component Id="StartIntegration" Guid="@START_GUID@" Win64="yes">
    <RegistryValue Root="HKMU" Key="Software\ShruggieTech\LocalMediaGallery" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    <Shortcut Id="StartShortcut" Directory="ProgramMenuFolder" Name="Local Media Gallery" Target="[INSTALLDIR]local-media-gallery.exe" WorkingDirectory="INSTALLDIR" Icon="ApplicationIcon" />
   </Component>
   <Component Id="UserPathIntegration" Guid="@USER_PATH_GUID@" Win64="yes">
    <Condition>NOT ALLUSERS</Condition>
    <RegistryValue Root="HKCU" Key="Software\ShruggieTech\LocalMediaGallery" Name="CommandPath" Type="integer" Value="1" KeyPath="yes" />
    <Environment Id="UserCommandPath" Name="PATH" Value="[INSTALLDIR]" Action="set" Part="last" System="no" Permanent="no" />
   </Component>
   <Component Id="MachinePathIntegration" Guid="@MACHINE_PATH_GUID@" Win64="yes">
    <Condition>ALLUSERS=1</Condition>
    <RegistryValue Root="HKLM" Key="Software\ShruggieTech\LocalMediaGallery" Name="CommandPath" Type="integer" Value="1" KeyPath="yes" />
    <Environment Id="MachineCommandPath" Name="PATH" Value="[INSTALLDIR]" Action="set" Part="last" System="yes" Permanent="no" />
   </Component>
  </DirectoryRef>
  <Feature Id="Application" Title="Application registration" Level="1" Absent="disallow"><ComponentRef Id="Integration" /></Feature>
  <Feature Id="Payload" Title="Gallery application" Level="1" Absent="disallow">@COMPONENT_REFS@</Feature>
  @NOTICE_FEATURE@
  <Feature Id="StartMenu" Title="Start menu shortcut" Level="1"><ComponentRef Id="StartIntegration" /></Feature>
  <Feature Id="CommandPath" Title="Command PATH" Level="2"><ComponentRef Id="UserPathIntegration" /><ComponentRef Id="MachinePathIntegration" /></Feature>
  <!-- Legacy products are removed inside the standard rollback transaction after ownership preflight. -->
  <Upgrade Id="{4A53AE01-FF50-4B42-AC2C-7D4EE30FD389}"><UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes" Maximum="@VERSION@" IncludeMaximum="yes" Property="LMG_OLD_USER" /></Upgrade>
  <Upgrade Id="{0A757FF9-91A9-4A07-BA0B-4BD4286E6860}"><UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes" Maximum="@VERSION@" IncludeMaximum="yes" Property="LMG_OLD_MACHINE" /></Upgrade>
  <Binary Id="Ownership" SourceFile="@HELPER@" />
  <CustomAction Id="Configure" BinaryKey="Ownership" DllEntry="Configure" Execute="immediate" Return="check" />
  <CustomAction Id="SelectScope" BinaryKey="Ownership" DllEntry="SelectScope" Execute="immediate" Return="check" />
  <CustomAction Id="SelectFeatures" BinaryKey="Ownership" DllEntry="SelectFeatures" Execute="immediate" Return="check" />
  <CustomAction Id="Preflight" BinaryKey="Ownership" DllEntry="Preflight" Execute="immediate" Return="check" />
  <CustomAction Id="SetInstallLocation" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]" />
  <CustomAction Id="ProvisionUserRuntime" BinaryKey="Ownership" DllEntry="ProvisionRuntime" Execute="deferred" Impersonate="yes" Return="check" />
  <CustomAction Id="ProvisionMachineRuntime" BinaryKey="Ownership" DllEntry="ProvisionRuntime" Execute="deferred" Impersonate="no" Return="check" />
  <CustomAction Id="VerifyUserInstalled" BinaryKey="Ownership" DllEntry="VerifyInstalled" Execute="deferred" Impersonate="yes" Return="check" />
  <CustomAction Id="VerifyMachineInstalled" BinaryKey="Ownership" DllEntry="VerifyInstalled" Execute="deferred" Impersonate="no" Return="check" />
  <CustomAction Id="RuntimeResult" BinaryKey="Ownership" DllEntry="RuntimeResult" Execute="immediate" Return="check" />
  <InstallUISequence>
   <Custom Action="Configure" Before="CostInitialize">NOT Installed</Custom>
   <Show Dialog="WelcomeDlg" Before="ProgressDlg">NOT Installed</Show>
   <Show Dialog="MaintenanceWelcomeDlg" Before="ProgressDlg">Installed AND NOT RESUME AND NOT Preselected</Show>
  </InstallUISequence>
  <InstallExecuteSequence>
   <Custom Action="Configure" Before="CostInitialize">1</Custom>
   <Custom Action="SelectFeatures" After="CostFinalize">NOT REMOVE="ALL"</Custom>
   <Custom Action="SetInstallLocation" After="SelectFeatures">NOT REMOVE="ALL"</Custom>
   <Custom Action="Preflight" Before="InstallInitialize">1</Custom>
   <RemoveExistingProducts After="InstallInitialize" />
   <Custom Action="ProvisionUserRuntime" After="RemoveExistingProducts">NOT REMOVE="ALL" AND NOT ALLUSERS</Custom>
   <Custom Action="ProvisionMachineRuntime" After="ProvisionUserRuntime">NOT REMOVE="ALL" AND ALLUSERS=1</Custom>
   <Custom Action="VerifyUserInstalled" Before="InstallFinalize">NOT REMOVE="ALL" AND NOT ALLUSERS</Custom>
   <Custom Action="VerifyMachineInstalled" After="VerifyUserInstalled">NOT REMOVE="ALL" AND ALLUSERS=1</Custom>
   <Custom Action="RuntimeResult" After="InstallFinalize">NOT REMOVE="ALL"</Custom>
  </InstallExecuteSequence>
  <UI Id="GalleryInstallerUI">
   <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="9" />
   <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
   <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
   <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
   <Property Id="WixUI_Mode" Value="InstallDir" />
   <DialogRef Id="WelcomeDlg" /><DialogRef Id="LicenseAgreementDlg" /><DialogRef Id="VerifyReadyDlg" />
   <DialogRef Id="MaintenanceWelcomeDlg" /><DialogRef Id="MaintenanceTypeDlg" />
   <DialogRef Id="ErrorDlg" /><DialogRef Id="FatalError" /><DialogRef Id="FilesInUse" /><DialogRef Id="MsiRMFilesInUse" />
   <DialogRef Id="PrepareDlg" /><DialogRef Id="ProgressDlg" /><DialogRef Id="ResumeDlg" /><DialogRef Id="UserExit" />
   <Dialog Id="ScopeDlg" Width="370" Height="270" Title="Local Media Gallery Setup">
    <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\WixUI_Font_Bigger}Choose who can use the gallery" />
    <Control Id="Explanation" Type="Text" X="20" Y="56" Width="330" Height="35" Text="Install for your Windows account or for everyone. All-users installation requests Windows administrator authorization." />
    <Control Id="Scope" Type="RadioButtonGroup" X="20" Y="100" Width="330" Height="64" Property="LMG_SCOPE">
     <RadioButtonGroup Property="LMG_SCOPE"><RadioButton Value="user" X="0" Y="0" Width="325" Height="20" Text="Only for me" /><RadioButton Value="machine" X="0" Y="32" Width="325" Height="20" Text="For all users" /></RadioButtonGroup>
     <Condition Action="disable">LMG_EXISTING</Condition>
    </Control>
    <Control Id="Existing" Type="Text" X="20" Y="180" Width="330" Height="35" Text="An existing installation keeps its scope and location during maintenance." />
    <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back"><Publish Event="NewDialog" Value="LicenseAgreementDlg">1</Publish></Control>
    <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next"><Publish Event="DoAction" Value="SelectScope" Order="1">1</Publish><Publish Event="NewDialog" Value="OptionsDlg" Order="2">1</Publish></Control>
    <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel"><Publish Event="SpawnDialog" Value="CancelDlg">1</Publish></Control>
   </Dialog>
   <Dialog Id="OptionsDlg" Width="370" Height="270" Title="Local Media Gallery Setup">
    <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\WixUI_Font_Bigger}Choose location and shortcuts" />
    <Control Id="LocationLabel" Type="Text" X="20" Y="60" Width="330" Height="16" Text="Installation &amp;location:" />
    <Control Id="Location" Type="PathEdit" X="20" Y="80" Width="330" Height="20" Property="INSTALLDIR"><Condition Action="disable">LMG_EXISTING</Condition></Control>
    <Control Id="StartMenu" Type="CheckBox" X="20" Y="120" Width="330" Height="20" Property="LMG_STARTMENU" CheckBoxValue="1" Text="Create a &amp;Start menu shortcut" />
    <Control Id="CommandPath" Type="CheckBox" X="20" Y="152" Width="330" Height="20" Property="LMG_PATH" CheckBoxValue="1" Text="Add the application to command &amp;PATH" />
    <Control Id="Runtime" Type="Text" X="20" Y="184" Width="330" Height="36" Text="Microsoft WebView2 is included and installed automatically when needed. No Internet connection is required." />
    <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back"><Publish Event="NewDialog" Value="ScopeDlg">1</Publish></Control>
    <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next"><Publish Event="SetTargetPath" Value="INSTALLDIR" Order="1">1</Publish><Publish Event="NewDialog" Value="VerifyReadyDlg" Order="2">1</Publish></Control>
    <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel"><Publish Event="SpawnDialog" Value="CancelDlg">1</Publish></Control>
   </Dialog>
   <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999">1</Publish>
   <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg">NOT Installed</Publish>
   <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">1</Publish>
   <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="ScopeDlg">LicenseAccepted="1"</Publish>
   <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="OptionsDlg">NOT Installed</Publish>
   <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg">Installed</Publish>
   <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
   <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
   <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
   <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
   <Property Id="ARPNOMODIFY" Value="1" />
  </UI>
  <UIRef Id="WixUI_Common" />
 </Product>
</Wix>
