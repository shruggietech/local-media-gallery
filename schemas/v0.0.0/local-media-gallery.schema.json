{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-media-gallery:0.0.0",
  "title": "Local Media Gallery runtime snapshot",
  "x-release-version": "0.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sessionId",
    "root",
    "status",
    "revision",
    "mediaOrigin",
    "items",
    "issues"
  ],
  "properties": {
    "version": {
      "const": "0.0.0"
    },
    "sessionId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      ]
    },
    "root": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "selection",
        "scanning",
        "complete",
        "partial",
        "unavailable"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "mediaOrigin": {
      "type": "string",
      "pattern": "^(|http://127\\.0\\.0\\.1:[0-9]+)$"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "name",
        "relativePath",
        "kind",
        "mime",
        "size",
        "modifiedMs",
        "issue"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "name": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "video"
          ]
        },
        "mime": {
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          ]
        },
        "modifiedMs": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          ]
        },
        "issue": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "version",
        "formatVersion",
        "pageSize",
        "cardSize",
        "controlsExpanded",
        "scrollIndicator",
        "metadataExpanded",
        "filter",
        "sort",
        "direction"
      ],
      "properties": {
        "version": {
          "const": "0.0.0"
        },
        "formatVersion": {
          "const": 1
        },
        "pageSize": {
          "enum": [
            24,
            48,
            96
          ]
        },
        "cardSize": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "controlsExpanded": {
          "type": "boolean"
        },
        "scrollIndicator": {
          "enum": [
            "auto",
            "always"
          ]
        },
        "metadataExpanded": {
          "type": "boolean"
        },
        "filter": {
          "enum": [
            "all",
            "image",
            "video"
          ]
        },
        "sort": {
          "enum": [
            "name",
            "modified",
            "size"
          ]
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        }
      }
    }
  }
}
