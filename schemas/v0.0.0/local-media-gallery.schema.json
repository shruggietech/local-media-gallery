{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-media-gallery:0.0.0",
  "title": "Local Media Gallery runtime snapshot",
  "x-release-version": "0.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sequence",
    "discovery",
    "sessionId",
    "root",
    "status",
    "revision",
    "mediaOrigin",
    "items",
    "issues",
    "metadataRevision"
  ],
  "properties": {
    "version": {
      "const": "0.0.0"
    },
    "sessionId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      ]
    },
    "root": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "selection",
        "opening",
        "scanning",
        "complete",
        "partial",
        "cancelled",
        "failed",
        "unavailable"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "mediaOrigin": {
      "type": "string",
      "pattern": "^(|http://127\\.0\\.0\\.1:[0-9]+)$"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sequence": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "discovery": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/discovery"
        }
      ]
    },
    "metadataRevision": {
      "type": "string",
      "pattern": "^(0|[a-f0-9]{32})$"
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "name",
        "relativePath",
        "kind",
        "mime",
        "size",
        "modifiedMs",
        "issue",
        "stale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "name": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "video"
          ]
        },
        "mime": {
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          ]
        },
        "modifiedMs": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          ]
        },
        "issue": {
          "type": [
            "string",
            "null"
          ]
        },
        "stale": {
          "type": "boolean",
          "description": "Prior observation not yet confirmed by the latest incomplete discovery."
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "version",
        "formatVersion",
        "pageSize",
        "cardSize",
        "controlsExpanded",
        "scrollIndicator",
        "metadataExpanded",
        "filter",
        "sort",
        "direction"
      ],
      "properties": {
        "version": {
          "const": "0.0.0"
        },
        "formatVersion": {
          "const": 1
        },
        "pageSize": {
          "enum": [
            24,
            48,
            96
          ]
        },
        "cardSize": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "controlsExpanded": {
          "type": "boolean"
        },
        "scrollIndicator": {
          "enum": [
            "auto",
            "always"
          ]
        },
        "metadataExpanded": {
          "type": "boolean"
        },
        "filter": {
          "enum": [
            "all",
            "image",
            "video"
          ]
        },
        "sort": {
          "enum": [
            "name",
            "modified",
            "size"
          ]
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        },
        "fontScale": {
          "enum": [
            80,
            90,
            100
          ],
          "default": 100
        },
        "summaryFields": {
          "type": "array",
          "default": [],
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/summaryField"
          }
        },
        "loadingMode": {
          "enum": [
            "automatic",
            "conservative",
            "standard"
          ],
          "default": "automatic"
        }
      }
    },
    "settingsChoices": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "pageSize": {
          "enum": [
            24,
            48,
            96
          ]
        },
        "cardSize": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "controlsExpanded": {
          "type": "boolean"
        },
        "scrollIndicator": {
          "enum": [
            "auto",
            "always"
          ]
        },
        "metadataExpanded": {
          "type": "boolean"
        },
        "filter": {
          "enum": [
            "all",
            "image",
            "video"
          ]
        },
        "sort": {
          "enum": [
            "name",
            "modified",
            "size"
          ]
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        },
        "fontScale": {
          "enum": [
            80,
            90,
            100
          ],
          "default": 100
        },
        "summaryFields": {
          "type": "array",
          "default": [],
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/summaryField"
          }
        },
        "loadingMode": {
          "enum": [
            "automatic",
            "conservative",
            "standard"
          ],
          "default": "automatic"
        }
      }
    },
    "settingsPatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "pageSize": {
          "enum": [
            24,
            48,
            96
          ]
        },
        "cardSize": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "controlsExpanded": {
          "type": "boolean"
        },
        "scrollIndicator": {
          "enum": [
            "auto",
            "always"
          ]
        },
        "metadataExpanded": {
          "type": "boolean"
        },
        "filter": {
          "enum": [
            "all",
            "image",
            "video"
          ]
        },
        "sort": {
          "enum": [
            "name",
            "modified",
            "size"
          ]
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        },
        "fontScale": {
          "enum": [
            80,
            90,
            100
          ],
          "default": 100
        },
        "summaryFields": {
          "type": "array",
          "default": [],
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/summaryField"
          }
        },
        "loadingMode": {
          "enum": [
            "automatic",
            "conservative",
            "standard"
          ],
          "default": "automatic"
        }
      }
    },
    "portableSettings": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "product",
        "kind",
        "version",
        "formatVersion",
        "choices"
      ],
      "properties": {
        "product": {
          "const": "local-media-gallery"
        },
        "kind": {
          "const": "gallery-settings"
        },
        "version": {
          "const": "0.0.0"
        },
        "formatVersion": {
          "const": 1
        },
        "choices": {
          "$ref": "#/$defs/settingsChoices"
        }
      }
    },
    "recentDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayPath",
        "lastActivityMs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayPath": {
          "type": "string"
        },
        "lastActivityMs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "settingsEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings",
        "revision",
        "sessionId",
        "warning",
        "sources",
        "savedTo",
        "layers",
        "recents",
        "destinations"
      ],
      "properties": {
        "settings": {
          "$ref": "#/$defs/settings"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "warning": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pageSize",
            "cardSize",
            "controlsExpanded",
            "scrollIndicator",
            "metadataExpanded",
            "filter",
            "sort",
            "direction",
            "fontScale",
            "summaryFields",
            "loadingMode"
          ],
          "properties": {
            "pageSize": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "cardSize": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "controlsExpanded": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "scrollIndicator": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "metadataExpanded": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "filter": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "sort": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "direction": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "fontScale": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "summaryFields": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "loadingMode": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            }
          }
        },
        "savedTo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pageSize": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "cardSize": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "controlsExpanded": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "scrollIndicator": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "metadataExpanded": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "filter": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "sort": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "direction": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "fontScale": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "summaryFields": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "loadingMode": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            }
          }
        },
        "layers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session",
            "user",
            "remembered",
            "portable"
          ],
          "properties": {
            "session": {
              "$ref": "#/$defs/settingsChoices"
            },
            "user": {
              "$ref": "#/$defs/settingsChoices"
            },
            "remembered": {
              "$ref": "#/$defs/settingsChoices"
            },
            "portable": {
              "$ref": "#/$defs/settingsChoices"
            }
          }
        },
        "recents": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/recentDirectory"
          }
        },
        "destinations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session": {
              "type": "string"
            },
            "user": {
              "type": "string"
            },
            "remembered": {
              "type": "string"
            },
            "portable": {
              "type": "string"
            }
          }
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "generation",
        "kind",
        "phase",
        "entriesSeen",
        "mediaSeen",
        "requestedRoot",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "kind": {
          "enum": [
            "open",
            "refresh"
          ]
        },
        "phase": {
          "enum": [
            "opening",
            "scanning",
            "complete",
            "partial",
            "cancelled",
            "failed",
            "unavailable"
          ]
        },
        "entriesSeen": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "mediaSeen": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "requestedRoot": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "fieldStep": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "key",
            "occurrence"
          ],
          "properties": {
            "kind": {
              "const": "key"
            },
            "key": {
              "type": "string",
              "maxLength": 1024
            },
            "occurrence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 19999
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "index"
          ],
          "properties": {
            "kind": {
              "const": "index"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 19999
            }
          }
        }
      ]
    },
    "summaryField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "path"
      ],
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 1024,
          "anyOf": [
            {
              "enum": [
                "full-name-meta",
                "full-name-json",
                "stem-json"
              ]
            },
            {
              "pattern": "^index:[^/\\\\\\u0000]+$",
              "not": {
                "enum": [
                  "index:.",
                  "index:.."
                ]
              }
            },
            {
              "pattern": "^index-native:(windows:([0-9a-f]{4})+|unix:([0-9a-f]{2})+)$"
            }
          ]
        },
        "path": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/fieldStep"
          }
        }
      }
    },
    "metadataNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "number"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "$ref": "#/$defs/metadataNode"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "members"
          ],
          "properties": {
            "type": {
              "const": "object"
            },
            "members": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "value"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "value": {
                    "$ref": "#/$defs/metadataNode"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "metadataDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "label",
        "basis",
        "rank",
        "ambiguous",
        "stale",
        "status",
        "message",
        "node",
        "sourceText",
        "recordPath"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "ambiguous": {
          "type": "boolean"
        },
        "stale": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "ready",
            "invalid",
            "limited",
            "encoding",
            "unreadable",
            "changed"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "node": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/metadataNode"
            }
          ]
        },
        "sourceText": {
          "type": [
            "string",
            "null"
          ]
        },
        "recordPath": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "metadataResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "itemId",
        "itemRevision",
        "metadataRevision",
        "documents",
        "limitations"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "itemId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "itemRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "metadataRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "documents": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/metadataDocument"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
