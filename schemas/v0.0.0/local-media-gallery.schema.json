{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-media-gallery:0.0.0",
  "title": "Local Media Gallery runtime snapshot",
  "x-release-version": "0.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sequence",
    "discovery",
    "sessionId",
    "root",
    "status",
    "revision",
    "mediaOrigin",
    "items",
    "issues"
  ],
  "properties": {
    "version": {
      "const": "0.0.0"
    },
    "sessionId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      ]
    },
    "root": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "selection",
        "opening",
        "scanning",
        "complete",
        "partial",
        "cancelled",
        "failed",
        "unavailable"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "mediaOrigin": {
      "type": "string",
      "pattern": "^(|http://127\\.0\\.0\\.1:[0-9]+)$"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sequence": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "discovery": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/discovery"
        }
      ]
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "name",
        "relativePath",
        "kind",
        "mime",
        "size",
        "modifiedMs",
        "issue",
        "stale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "name": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "video"
          ]
        },
        "mime": {
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          ]
        },
        "modifiedMs": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          ]
        },
        "issue": {
          "type": [
            "string",
            "null"
          ]
        },
        "stale": {
          "type": "boolean",
          "description": "Prior observation not yet confirmed by the latest incomplete discovery."
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "version",
        "formatVersion",
        "pageSize",
        "cardSize",
        "controlsExpanded",
        "scrollIndicator",
        "metadataExpanded",
        "filter",
        "sort",
        "direction"
      ],
      "properties": {
        "version": {
          "const": "0.0.0"
        },
        "formatVersion": {
          "const": 1
        },
        "pageSize": {
          "enum": [
            24,
            48,
            96
          ]
        },
        "cardSize": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "controlsExpanded": {
          "type": "boolean"
        },
        "scrollIndicator": {
          "enum": [
            "auto",
            "always"
          ]
        },
        "metadataExpanded": {
          "type": "boolean"
        },
        "filter": {
          "enum": [
            "all",
            "image",
            "video"
          ]
        },
        "sort": {
          "enum": [
            "name",
            "modified",
            "size"
          ]
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        },
        "fontScale": {
          "enum": [
            80,
            90,
            100
          ],
          "default": 100
        }
      }
    },
    "settingsChoices": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "pageSize": {
          "enum": [
            24,
            48,
            96
          ]
        },
        "cardSize": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "controlsExpanded": {
          "type": "boolean"
        },
        "scrollIndicator": {
          "enum": [
            "auto",
            "always"
          ]
        },
        "metadataExpanded": {
          "type": "boolean"
        },
        "filter": {
          "enum": [
            "all",
            "image",
            "video"
          ]
        },
        "sort": {
          "enum": [
            "name",
            "modified",
            "size"
          ]
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        },
        "fontScale": {
          "enum": [
            80,
            90,
            100
          ],
          "default": 100
        }
      }
    },
    "settingsPatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "pageSize": {
          "enum": [
            24,
            48,
            96
          ]
        },
        "cardSize": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "controlsExpanded": {
          "type": "boolean"
        },
        "scrollIndicator": {
          "enum": [
            "auto",
            "always"
          ]
        },
        "metadataExpanded": {
          "type": "boolean"
        },
        "filter": {
          "enum": [
            "all",
            "image",
            "video"
          ]
        },
        "sort": {
          "enum": [
            "name",
            "modified",
            "size"
          ]
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        },
        "fontScale": {
          "enum": [
            80,
            90,
            100
          ],
          "default": 100
        }
      }
    },
    "portableSettings": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "product",
        "kind",
        "version",
        "formatVersion",
        "choices"
      ],
      "properties": {
        "product": {
          "const": "local-media-gallery"
        },
        "kind": {
          "const": "gallery-settings"
        },
        "version": {
          "const": "0.0.0"
        },
        "formatVersion": {
          "const": 1
        },
        "choices": {
          "$ref": "#/$defs/settingsChoices"
        }
      }
    },
    "recentDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayPath",
        "lastActivityMs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayPath": {
          "type": "string"
        },
        "lastActivityMs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "settingsEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings",
        "revision",
        "sessionId",
        "warning",
        "sources",
        "savedTo",
        "layers",
        "recents",
        "destinations"
      ],
      "properties": {
        "settings": {
          "$ref": "#/$defs/settings"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "warning": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pageSize",
            "cardSize",
            "controlsExpanded",
            "scrollIndicator",
            "metadataExpanded",
            "filter",
            "sort",
            "direction",
            "fontScale"
          ],
          "properties": {
            "pageSize": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "cardSize": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "controlsExpanded": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "scrollIndicator": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "metadataExpanded": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "filter": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "sort": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "direction": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "fontScale": {
              "enum": [
                "default",
                "session",
                "user",
                "remembered",
                "portable"
              ]
            }
          }
        },
        "savedTo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pageSize": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "cardSize": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "controlsExpanded": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "scrollIndicator": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "metadataExpanded": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "filter": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "sort": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "direction": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            },
            "fontScale": {
              "enum": [
                "session",
                "user",
                "remembered",
                "portable"
              ]
            }
          }
        },
        "layers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session",
            "user",
            "remembered",
            "portable"
          ],
          "properties": {
            "session": {
              "$ref": "#/$defs/settingsChoices"
            },
            "user": {
              "$ref": "#/$defs/settingsChoices"
            },
            "remembered": {
              "$ref": "#/$defs/settingsChoices"
            },
            "portable": {
              "$ref": "#/$defs/settingsChoices"
            }
          }
        },
        "recents": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/recentDirectory"
          }
        },
        "destinations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session": {
              "type": "string"
            },
            "user": {
              "type": "string"
            },
            "remembered": {
              "type": "string"
            },
            "portable": {
              "type": "string"
            }
          }
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "generation",
        "kind",
        "phase",
        "entriesSeen",
        "mediaSeen",
        "requestedRoot",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "kind": {
          "enum": [
            "open",
            "refresh"
          ]
        },
        "phase": {
          "enum": [
            "opening",
            "scanning",
            "complete",
            "partial",
            "cancelled",
            "failed",
            "unavailable"
          ]
        },
        "entriesSeen": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "mediaSeen": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "requestedRoot": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
