{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-media-gallery:linux-application-payload:0.0.0",
  "title": "Unpublished Linux application payload identity",
  "x-release-version": "0.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generation",
    "product",
    "kind",
    "formatVersion",
    "version",
    "edition",
    "os",
    "arch",
    "targetTriple",
    "buildProfile",
    "source",
    "revision",
    "binary",
    "files",
    "entrypoint",
    "candidate",
    "dependencies"
  ],
  "properties": {
    "generation": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "product": {
      "const": "local-media-gallery"
    },
    "kind": {
      "const": "linux-application-payload"
    },
    "formatVersion": {
      "const": 1
    },
    "version": {
      "const": "0.0.0"
    },
    "edition": {
      "enum": [
        "full",
        "lite"
      ]
    },
    "os": {
      "const": "linux"
    },
    "arch": {
      "const": "x86_64"
    },
    "targetTriple": {
      "const": "x86_64-unknown-linux-gnu"
    },
    "buildProfile": {
      "const": "release"
    },
    "source": {
      "type": "object",
      "required": [
        "sha256",
        "files"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "files": {
          "type": "integer",
          "minimum": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "binary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256",
          "mode"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "mode": {
            "enum": [
              "644",
              "755"
            ]
          }
        }
      }
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "candidate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "dependencies": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^[^\\u0000-\\u001f]+$"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$comment": "The Node validator additionally enforces exact edition paths, fixed Full integration, unique owned normal relative regular files, required notices, executable modes and metadata authority without recursive self hashing. Containers remain unpublished candidates."
}
