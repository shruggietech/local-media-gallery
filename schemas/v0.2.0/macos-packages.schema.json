{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-media-gallery:macos-application-payload:0.2.0",
  "title": "Unpublished macOS application payload identity",
  "x-release-version": "0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generation",
    "product",
    "kind",
    "formatVersion",
    "version",
    "edition",
    "os",
    "arch",
    "targetTriple",
    "buildProfile",
    "source",
    "revision",
    "binary",
    "files",
    "bundle"
  ],
  "properties": {
    "generation": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "product": {
      "const": "local-media-gallery"
    },
    "kind": {
      "const": "macos-application-payload"
    },
    "formatVersion": {
      "const": 1
    },
    "version": {
      "const": "0.2.0"
    },
    "edition": {
      "enum": [
        "full",
        "lite"
      ]
    },
    "os": {
      "const": "macos"
    },
    "arch": {
      "const": "aarch64"
    },
    "targetTriple": {
      "const": "aarch64-apple-darwin"
    },
    "buildProfile": {
      "const": "release"
    },
    "source": {
      "type": "object",
      "required": [
        "sha256",
        "files"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "files": {
          "type": "integer",
          "minimum": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "binary": {
      "const": "Contents/MacOS/local-media-gallery"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256",
          "mode"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "mode": {
            "enum": [
              "644",
              "755"
            ]
          }
        }
      }
    },
    "bundle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$comment": "Native/Node validators additionally require unique normal relative paths, complete bundle assets and signature resources, matching binary membership, exact file hashes and executable modes. Container inventory hashes this manifest without self reference. Candidates remain unpublished."
}
