ntorySha256":"f316b83b8b58d8731887a7b52113a388e64836f7561c7e1e7f8a19146b61aa5e","major":false,"notes":"Reviewed ordinary MSI authorization, predecessor identity, native registration, retained data, canonical publication and versioned schema vocabulary against the v0.2.2 source contracts. Existing glossary definitions and local usage links remain applicable.","reviewedAt":"2026-11-06","reviewer":"S034 release preparation","terms":[{"definition":"A documented structure/operation produced or controlled by the gallery, such as settings or native messages; distinct from arbitrary external sidecars","references":"[Local contract boundary](interfaces-and-contracts.md#contract-boundaries)","term":"Application-owned contract"},{"definition":"Windows user application-data locations; the installed product's settings belong beneath the appropriate AppData scope","references":"[Windows known folders](https://learn.microsoft.com/en-us/windows/win32/shell/knownfolderid), [installed locations](configuration-and-state.md#installed-locations)","term":"AppData"},{"definition":"A platform package presenting an application with its executable/resources as a unit; its internal executable directory need not be the gallery root","references":"[Tauri macOS bundles](https://tauri.app/distribute/macos-application-bundle/), [root resolution](gallery-lifecycle.md#root-selection-and-identity)","term":"Application bundle"},{"definition":"A concrete distributable file or package whose version, platform and integrity can be identified","references":"[Distribution contract](installation-and-distribution.md#distribution-contract)","term":"Artifact"},{"definition":"Permission to begin one bounded preparation or native response; different resource classes have separate limits","references":"[Loading policy](thumbnails-and-performance.md#adaptive-loading)","term":"Admission"},{"definition":"Elapsed monotonic time between visible animation callbacks; a responsiveness observation rather than proof of compositor frame presentation","references":"[Rendering updates](https://html.spec.whatwg.org/multipage/webappapis.html#update-the-rendering), [measurement interpretation](thumbnails-and-performance.md#measurement-evidence-and-interpretation)","term":"Frame callback gap"},{"definition":"Process-private committed memory, reported separately from resident working-set pages","references":"[PrivateMemorySize64](https://learn.microsoft.com/en-us/dotnet/api/system.diagnostics.process.privatememorysize64), [measurement interpretation](thumbnails-and-performance.md#measurement-evidence-and-interpretation)","term":"Private bytes"},{"definition":"Rebuildable derived data used to avoid repeating work; it is not the authoritative media collection or sole copy of preferences","references":"[Cache contract](thumbnails-and-performance.md#cache-identity-and-freshness)","term":"Cache"},{"definition":"An encoding/decoding method for media; a file extension or container name alone does not establish that the active runtime can decode it","references":"[HTML media resources](https://html.spec.whatwg.org/multipage/media.html), [capability reporting](browsing-and-playback.md#playback-and-capability-reporting)","term":"Codec"},{"definition":"A media file structure that can hold encoded streams and related information; it is distinct from the codecs used by those streams","references":"[HTML media resources](https://html.spec.whatwg.org/multipage/media.html), [playback](browsing-and-playback.md#playback-and-capability-reporting)","term":"Container"},{"definition":"Expiration of machine-local remembered-location state after an explicitly chosen inactivity policy","references":"[Remembered state](configuration-and-state.md#remembered-directory-state-and-decay)","term":"Decay"},{"definition":"One explicitly requested opening or Refresh with its own ordering, cancellation and terminal result, independent of the lifetime of a gallery session","references":"[Requested discovery](gallery-lifecycle.md#opening-and-discovery), [native interface](interfaces-and-contracts.md#native-and-frontend-operations)","term":"Discovery operation"},{"definition":"A previous item not confirmed by the latest incomplete discovery; it remains distinguishable from a current observation and is not proof of deletion","references":"[Maintaining a current view](gallery-lifecycle.md#maintaining-a-current-view)","term":"Stale observation"},{"definition":"The installed product distribution providing declared dependencies, system integration and persistent user state","references":"[Editions](overview.md#editions), [installation](installation-and-distribution.md#full-installation-and-lite-operation)","term":"Full installation"},{"definition":"The selected directory against which a gallery session discovers and resolves its media","references":"[Root selection](gallery-lifecycle.md#root-selection-and-identity)","term":"Gallery root"},{"definition":"A logical revision of a scan, item or source observation used to prevent obsolete asynchronous results from overwriting newer state","references":"[Native interface](interfaces-and-contracts.md#native-and-frontend-operations)","term":"Generation"},{"definition":"Agreement between bytes/state and an identified expected representation; a checksum does not independently establish the trustworthiness of its source","references":"[Executable integrity](security-and-reliability.md#dependencies-and-executable-artifacts)","term":"Integrity"},{"definition":"Inter-process communication; here, the host/interface boundary used to request native operations and deliver results/events","references":"[Tauri process model](https://tauri.app/concept/process-model/), [native operations](interfaces-and-contracts.md#native-and-frontend-operations)","term":"IPC"},{"definition":"A text-based data interchange format supporting objects, arrays and scalar values; inspection must preserve meaningful source distinctions","references":"[RFC 8259](https://www.rfc-editor.org/rfc/rfc8259.html), [metadata model](metadata-and-sidecars.md#metadata-model)","term":"JSON"},{"definition":"A language for describing/validating JSON structures; a dialect must be declared when adopted for application-owned contracts","references":"[JSON Schema specifications](https://json-schema.org/draft/2020-12), [data contracts](interfaces-and-contracts.md#data-contracts-and-versioning)","term":"JSON Schema"},{"definition":"The lightweight application distribution intended for on-demand opening and sharing on supported hosts without installing Full","references":"[Editions](overview.md#editions)","term":"Lite"},{"definition":"Variable-height cards placed into the shortest available column while preserving a defined logical document and keyboard order","references":"[Card layout](browsing-and-playback.md#cards-and-layout)","term":"Masonry layout"},{"definition":"The original validated JSON number token, retained as text so exponent form, negative zero and large values survive native/frontend transport","references":"[RFC8259 numbers](https://www.rfc-editor.org/rfc/rfc8259.html#section-6), [exact metadata](metadata-and-sidecars.md#inspection-and-field-inclusion)","term":"Lexical number"},{"definition":"A relative source role plus decoded object-key occurrence or positional array-index steps, used to select metadata without persisting native access grants","references":"[Summary fields](metadata-and-sidecars.md#inspection-and-field-inclusion), [state resolution](configuration-and-state.md#resolution-and-persistence)","term":"Summary field address"},{"definition":"Information about an item from file observations, media inspection or external documents, presented with its source","references":"[Metadata and sidecars](metadata-and-sidecars.md#metadata-model)","term":"Metadata"},{"definition":"The Rust/Tauri application layer that owns filesystem, job, state and platform capabilities behind the interface","references":"[Tauri process model](https://tauri.app/concept/process-model/), [native core](architecture.md#native-host-and-gallery-core)","term":"Native host"},{"definition":"The React framework selected to build the website and statically exported gallery interface","references":"[Static export](https://nextjs.org/docs/app/guides/static-exports), [interface boundary](architecture.md#interface-build-and-runtime-data)","term":"Next.js"},{"definition":"A prescribed contract, distinguished from explanatory prose or an unresolved proposal by the specification's interpretation rules","references":"[RFC 2119](https://www.rfc-editor.org/rfc/rfc2119.html), [RFC 8174](https://www.rfc-editor.org/rfc/rfc8174.html), [interpretation](index.md#how-to-interpret-requirements)","term":"Normative requirement"},{"definition":"Dividing the fully filtered and sorted collection into bounded pages; it limits mounted cards without limiting total collection size","references":"[Collection presentation](browsing-and-playback.md#collection-presentation)","term":"Pagination"},{"definition":"Optional independent presentation, thumbnail and verified recipient-launcher work, previewed before gallery writes","references":"[Preparation lifecycle](gallery-lifecycle.md#optional-preparation)","term":"Preparation"},{"definition":"The recorded origin, identity and versions of an artifact or metadata observation, allowing its context to be evaluated","references":"[Data authority](architecture.md#data-flow-and-authority), [brand provenance](brand.md#provenance-and-updates)","term":"Provenance"},{"definition":"Comparing current directory contents with prior observations when opening or explicitly refreshing a gallery","references":"[Current view](gallery-lifecycle.md#maintaining-a-current-view)","term":"Reconciliation"},{"definition":"A native filesystem path interpreted against a defined base such as the current gallery root, rather than requiring the sender's absolute filesystem location","references":"[Rust native paths](https://doc.rust-lang.org/std/path/struct.Path.html), [root identity](gallery-lifecycle.md#root-selection-and-identity)","term":"Relative path"},{"definition":"A platform facility required to execute a particular artifact; distinct from tools used to build it","references":"[Build/runtime boundary](architecture.md#dependency-and-build-boundaries)","term":"Runtime prerequisite"},{"definition":"The native implementation language selected for the application; its ownership model manages memory through compiler-checked rules","references":"[Rust ownership](https://doc.rust-lang.org/book/ch04-01-what-is-ownership.html), [architecture](architecture.md#native-host-and-gallery-core)","term":"Rust"},{"definition":"Release numbering using major, minor and patch components with explicit compatibility meaning","references":"[SemVer 2.0.0](https://semver.org/spec/v2.0.0.html), [release identity](verification-and-compatibility.md#compatibility-and-version-identity)","term":"Semantic Versioning"},{"definition":"A separate nearby document associated with media through a declared matching/reference rule","references":"[Sidecar association](metadata-and-sidecars.md#association-and-discovery)","term":"Sidecar"},{"definition":"Ordered resolution of defaults, user choices, remembered choices, portable choices and explicit session intent, with a source for each field","references":"[Resolution](configuration-and-state.md#resolution-and-persistence)","term":"Settings precedence"},{"definition":"Sparse deliberate view choices carried by the gallery-local settings.json independently of a sender profile or path","references":"[Portable settings](configuration-and-state.md#portable-settings)","term":"Portable presentation"},{"definition":"Removal of convenience history at 90 days since successful opening or an explicit remembered save, without removing gallery data","references":"[Activity and decay](configuration-and-state.md#remembered-directory-state-and-decay)","term":"Inactivity expiry"},{"definition":"An embedded transactional SQL database engine, bundled for remembered-location state rather than a mandatory external media catalog","references":"[SQLite](https://sqlite.org/about.html), [remembered state](configuration-and-state.md#remembered-directory-state-and-decay)","term":"SQLite"},{"definition":"Build-produced HTML/CSS/JavaScript assets that do not need a Next.js runtime server for the exported interface","references":"[Next.js static exports](https://nextjs.org/docs/app/guides/static-exports), [interface build](architecture.md#interface-build-and-runtime-data)","term":"Static export"},{"definition":"An OS/architecture/runtime combination explicitly supported by an artifact's release contract","references":"[Distribution identity](installation-and-distribution.md#distribution-contract)","term":"Supported host"},{"definition":"The selected native application framework connecting Rust application capabilities to a webview interface","references":"[Tauri architecture](https://tauri.app/concept/process-model/), [system context](architecture.md#system-context)","term":"Tauri"},{"definition":"A derived lower-cost visual representation used for browsing, not a required original or authoritative source","references":"[Thumbnail contract](thumbnails-and-performance.md#optional-generation-lifecycle)","term":"Thumbnail"},{"definition":"A structured resource identifier; URI escaping and filesystem path interpretation are separate operations","references":"[RFC 3986](https://www.rfc-editor.org/rfc/rfc3986.html), [media delivery](interfaces-and-contracts.md#media-delivery-and-item-references)","term":"URI"},{"definition":"Rendering a bounded useful portion of a larger logical collection, with additional work admitted as the view changes","references":"[Adaptive loading](thumbnails-and-performance.md#adaptive-loading)","term":"Virtualized rendering"},{"definition":"An accessibility conformance level; relevant rendered behavior must be evaluated rather than inferred from a source declaration","references":"[WCAG 2.2](https://www.w3.org/TR/WCAG22/), [interaction](browsing-and-playback.md#interaction-accessibility-and-feedback)","term":"WCAG AA"},{"definition":"A native application's embedded web-content rendering surface, which has platform runtime dependencies without requiring a user-selected browser application","references":"[Tauri process model](https://tauri.app/concept/process-model/), [dependency boundary](architecture.md#dependency-and-build-boundaries)","term":"Webview"},{"definition":"Linux user directory conventions separating configuration, persistent state and disposable caches","references":"[XDG Base Directory Specification](https://specifications.freedesktop.org/basedir/latest/), [installed locations](configuration-and-state.md#installed-locations)","term":"XDG locations"},{"definition":"Application binary interface, including native calling/linking and library compatibility; a newer Linux build does not establish compatibility with an older glibc","references":"[Rust platform support](https://doc.rust-lang.org/rustc/platform-support.html), [platform matrix](installation-and-distribution.md#initial-platform-and-dependency-matrix)","term":"ABI"},{"definition":"A bounded matching receipt that a detached child's main-window bridge and initial request are ready; distinct from discovery completion","references":"[Process lifetime](interfaces-and-contracts.md#native-command-syntax-and-process-lifetime)","term":"Startup acknowledgement"},{"definition":"Exact Windows UTF-16LE code-unit bytes or Unix filesystem bytes, separate from a display label","references":"[Rust OsStr](https://doc.rust-lang.org/std/ffi/struct.OsStr.html), [machine results](interfaces-and-contracts.md#machine-results-and-exit-codes)","term":"Native path encoding"},{"definition":"An identified exploratory payload with exact inventory and extracted native acceptance; it is not a final installer or published product release","references":"[Package policy](installation-and-distribution.md#package-and-installation-policy)","term":"Proof archive"},{"definition":"An identified proposed product version with exact artifacts and qualification evidence; it does not itself establish public availability","references":"[Release assembly](installation-and-distribution.md#verified-release-assembly-and-publication)","term":"Release candidate"},{"definition":"The verified published record binding actual release/tag/assets, source/version, artifact hashes and documentation gates to the current downloads","references":"[Release identity](installation-and-distribution.md#verified-release-assembly-and-publication)","term":"Canonical release record"},{"definition":"Matching complete retained-source, renderer, exported-output and check evidence required before product publication or canonical promotion","references":"[Publication gates](website-and-documentation.md#release-snapshots-and-documentation-gates)","term":"Documentation gate"},{"definition":"Locked replacement of invalid convenience preferences or in-place reinitialization of private history, excluding gallery-local documents and media","references":"[SQLite reset database](https://www.sqlite.org/c3ref/c_dbconfig_defensive.html#sqlitedbconfigresetdatabase), [recovery contract](configuration-and-state.md#corruption-migration-and-concurrency)","term":"Private-state reset"},{"definition":"Disposable workspace-owned profile and cache selected by a private maintainer build or isolated test host","references":"[Tauri directory overrides](https://v2.tauri.app/reference/config/#appdirectoriesoverride), [tooling locations](configuration-and-state.md#cache-browser-and-tooling-locations)","term":"Tooling state"}],"version":"v0.2.2"},"sourceRevision":"b196c564762d2a005cc3e4d3a9627b5ded0f342e"}
