{
  "name": "local-media-gallery",
  "version": "0.0.0",
  "private": true,
  "description": "Local Media Gallery repository maintenance tools",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "node --test tests/*.test.mjs",
    "brand:verify": "node scripts/sync-brand-kit.mjs --verify",
    "brand:check": "node scripts/sync-brand-kit.mjs --check",
    "brand:update": "node scripts/sync-brand-kit.mjs --update",
    "check:app": "node scripts/run.mjs check-app",
    "build:app": "node scripts/run.mjs build-app",
    "test:native": "node scripts/run.mjs test-native",
    "qualify": "node scripts/qualify.mjs",
    "app": "node scripts/run.mjs app",
    "prepare:local": "node scripts/prepare.mjs",
    "build:site": "node scripts/build-site.mjs",
    "check:site": "node scripts/check-site.mjs",
    "test:site": "node scripts/test-site.mjs",
    "ci": "node scripts/ci.mjs"
  },
  "workspaces": [
    "apps/gallery",
    "apps/site"
  ],
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.10.1",
    "@typescript-eslint/parser": "8.72.0",
    "ajv": "8.17.1",
    "eslint": "10.13.0",
    "stylelint": "17.16.0",
    "typescript": "7.0.2",
    "markdown-it": "15.0.3",
    "playwright": "1.56.1",
    "cheerio": "1.1.2",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@axe-core/playwright": "4.14.0"
  }
}
